# beatmania.app 환경설정 템플릿
#
# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 절대 커밋하지 않는다.
#   cp .env.example .env
#
# settings.py 가 BASE_DIR/.env 를 읽지만, 프로세스 환경변수가 항상 우선한다.
# 따라서 mod_wsgi(파일 방식)와 docker compose env_file(환경변수 방식) 양쪽에서
# 코드 변경 없이 그대로 동작한다.

# --- Django ---------------------------------------------------------------
# 필수. 바꾸면 로그인된 세션이 전부 끊긴다(전 사용자 재로그인).
# 새로 만들 때:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# 운영에서는 반드시 false. true 로 두면 예외 페이지에 설정값이 그대로 노출된다.
DJANGO_DEBUG=false

# 쉼표로 구분. 로컬 개발 시 127.0.0.1,localhost 를 추가한다.
DJANGO_ALLOWED_HOSTS=beatmania.app

# Apache 가 TLS 를 끊고 평문으로 넘겨 주는 구성이면 true.
# 켜면 Django 가 X-Forwarded-Proto 를 믿는다. 프록시 뒤가 아닐 때 켜면
# 누구든 그 헤더를 붙여 자기 요청을 HTTPS 인 척할 수 있으므로 false 로 둔다.
DJANGO_BEHIND_PROXY=true

# HSTS. 위의 DJANGO_BEHIND_PROXY=true 일 때만 나간다.
# 되돌리기가 어려운 헤더다 — 브라우저가 이 기간 동안 도메인을 기억하므로
# 잘못 내보내면 그동안 http 로 접속할 방법이 없다. 그래서 처음에는 1시간으로
# 두고, 배포 후 며칠 문제가 없으면 31536000(1년)으로 올린다.
DJANGO_HSTS_SECONDS=3600
# 서브도메인까지 강제할지. beatmania.app 에는 www 외의 서브도메인이 없지만,
# 나중에 하나라도 http 로 띄우면 접속이 막힌다. 확신이 설 때만 true.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false

# 로그 레벨. 평소 INFO, 무언가 쫓을 때만 DEBUG.
# 로그는 전부 stdout 으로 나가므로 docker compose logs -f app 으로 본다.
DJANGO_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
DB_NAME=iidxrank
DB_USER=iidxrank
DB_PASSWORD=
# mod_wsgi 로 호스트에서 직접 돌릴 때는 localhost.
# 컨테이너에서 호스트의 MySQL 에 붙을 때는 host.docker.internal
# (compose 의 extra_hosts 가 docker0 게이트웨이로 연결해 준다).
#
# 컨테이너에서 붙으면 MySQL 입장에서는 172.17.0.x 에서 온 접속으로 보인다.
# 'iidxrank'@'localhost' 권한만 있으면 거부되므로 브리지 대역을 열어 줘야 한다.
#   CREATE USER 'iidxrank'@'172.17.%' IDENTIFIED BY '...';
#   GRANT ALL PRIVILEGES ON iidxrank.* TO 'iidxrank'@'172.17.%';
# 그리고 MySQL 이 127.0.0.1 에만 묶여 있으면 bind-address 를 넓혀야 한다.
DB_HOST=host.docker.internal
DB_PORT=3306
# MySQL 8 에서 'utf8' 은 utf8mb3(3바이트) 의 별칭이다. 컬럼이 utf8mb4 인데
# 접속이 utf8mb3 이면 이모지 같은 4바이트 문자를 쓸 때 실패한다.
DB_CHARSET=utf8mb4

# --- reCAPTCHA (가입 폼) --------------------------------------------------
# https://www.google.com/recaptcha/admin 에서 발급
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# --- 선택 ------------------------------------------------------------------
# img.tl 업로드 연동. 현재 미사용이라 비워도 된다.
IMGTL_KEY=

# --- 컨테이너 운영 -------------------------------------------------------
# docker-compose.yml 이 읽는다. Django 는 쓰지 않는다.

# 호스트의 어느 포트로 낼지. 127.0.0.1 에만 묶이며 Apache 가 여기로 넘긴다.
APP_PORT=8731

# 사용자 업로드본이 실제로 놓이는 호스트 경로.
# 컨테이너가 uid 10001 로 돌므로 그 uid 가 쓸 수 있어야 한다.
#   sudo mkdir -p /srv/beatmania/media
#   sudo chown -R 10001:10001 /srv/beatmania/media
MEDIA_DIR=/srv/beatmania/media

# gunicorn 워커 수.
# 2*코어+1 공식은 그 기계가 이 앱 전용일 때의 값이다. DB·웹서버·다른 서비스와
# 한 박스를 나눠 쓴다면 앱 몫으로 칠 코어 수를 먼저 정하고 거기에 적용한다.
# 곡 갱신 명령이 워커 하나를 수 분간 붙잡으므로 여유가 있어야 한다.
# 재 보고 조정한다 — 이미지를 다시 만들 필요는 없다.
GUNICORN_WORKERS=5

# 요청 타임아웃(초). 대시보드의 updateSongInfinitas 가 수 분 걸리므로
# 기본 30초로는 워커가 죽는다.
GUNICORN_TIMEOUT=120
