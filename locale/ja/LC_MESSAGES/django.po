msgstr "アップロードされた記録は<a href=\"%(mypage_url)s\">日別打鍵記録</a>で確認できます。"

msgid "옵션"
msgstr "オプション"

msgid "옵조 난이도표 백업"
msgstr "Overjoy 難易度表（バックアップ）"

